# Copy this file to `.env` and fill in the values for your local setup.
# `.env` itself is gitignored -- it's machine-specific.
#
# See REQUIREMENTS.md §9 for the full list of supported variables.

# Required: address of the device under test.
DUT_ADDRESS=192.168.1.42:5555

# Optional, shown here with their defaults.
# DATA_DIR=/data
PORT=8080
# ADB_PATH=adb
# POLL_INTERVAL_SECONDS=15
# DEFAULT_RUN_TIMEOUT_SECONDS=1800
# THERMAL_GATE_CELSIUS=
# THERMAL_GATE_TIMEOUT_SECONDS=300
# DEVICE_PROFILE_FILE=
# PRECOMPILE_PACKAGE=true
# LOG_LEVEL=info
